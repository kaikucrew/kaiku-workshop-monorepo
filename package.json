{
  "name": "monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "ui",
    "api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=ui & npm run dev --workspace=api",
    "dev:ui": "npm run dev --workspace=ui",
    "dev:api": "npm run dev --workspace=api",
    "build": "npm run build --workspaces",
    "type-check": "npm run type-check --workspaces",
    "type-check:ui": "npm run type-check --workspace=ui",
    "type-check:api": "npm run type-check --workspace=api"
  }
}
